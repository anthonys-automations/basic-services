# Replaces the distribution config wholesale, so no sshd_config.d include.
# The host keys and the authorized_keys copy are the only runtime state; they
# live under /run/sandbox because /etc/ssh is root-owned and this sshd is not.
Port 2222
HostKey /run/sandbox/ssh/ssh_host_ed25519_key
HostKey /run/sandbox/ssh/ssh_host_rsa_key
PidFile /run/sandbox/sshd.pid
AuthorizedKeysFile /run/sandbox/authorized_keys
AllowUsers user
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM yes
X11Forwarding no
Subsystem sftp /usr/lib/openssh/sftp-server
